<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pda">

        <!-- Cấu hình để chia sẻ file log an toàn -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.pda.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.nhapkho.QuanLyNhapKhoActivity"
            android:exported="false"
            android:label="Quản lý nhập kho" />

        <activity
            android:name=".ui.nhapkho.po.NhapKhoPoDetailActivity"
            android:exported="false"
            android:label="Nhập kho theo PO" />

        <activity
            android:name=".ui.nhapkho.nvl.NhapKhoNvlDetailActivity"
            android:exported="false"
            android:label="Nhập kho theo NVL" />

        <activity
            android:name=".ui.nhapkho.invoice.NhapKhoInvoiceDetailActivity"
            android:exported="false"
            android:label="Nhập kho theo Invoice" />

        <activity
            android:name=".ui.xuatkho.QuanLyXuatKhoActivity"
            android:exported="false"
            android:label="Quản lý xuất kho" />

        <activity
            android:name=".ui.kiemke.QuanLyKiemKeActivity"
            android:exported="false"
            android:label="Quản lý kiểm kê" />

        <activity
            android:name=".ui.kiemke.barcode.KiemKeBarcodeDetailActivity"
            android:exported="false"
            android:label="Kiểm kê theo Barcode" />

        <activity
            android:name=".ui.kiemke.giado.KiemKeGiaDoDetailActivity"
            android:exported="false"
            android:label="Kiểm kê theo giá đỡ" />

        <activity
            android:name=".ui.kiemke.nvl.KiemKeNvlDetailActivity"
            android:exported="false"
            android:label="Kiểm kê theo mã NVL" />

        <activity
            android:name=".ui.kiemke.lot.KiemKeLotDetailActivity"
            android:exported="false"
            android:label="Kiểm kê theo mã Lot" />

    </application>

</manifest>
